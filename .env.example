# Use this as a template for .env.local
#
# Requests to NEXT_PUBLIC_API_URL are routed through the rewrite proxy in
# next.config.ts (see BACKEND_ORIGIN below) rather than hitting the backend
# directly, since it doesn't send CORS headers and a browser will block a
# cross-origin fetch to it outright.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=ws://130.185.120.78:8000/ws/v1
BACKEND_ORIGIN=http://130.185.120.78:8000
